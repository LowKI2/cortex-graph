{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2021"], "skipLibCheck": true, "noEmit": true,
    "strict": false, "noImplicitAny": true, "noImplicitThis": true, "strictBindCallApply": true,
    "isolatedModules": true, "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*.ts"]
}
